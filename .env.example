# Copy to .env before `docker compose up`. Compose reads this file for the
# ${VAR:-default} substitutions in docker-compose.yml.

# Daily API and the worker talk to the Compose Redis service.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ollama (default) or vllm
PMS_LLM_BACKEND=ollama
PMS_OLLAMA_MODEL=llama3

# Inside a container, localhost is the container. Point at Ollama on the Windows host.
OLLAMA_HOST=http://host.docker.internal:11434

# Used when PMS_LLM_BACKEND=vllm
PMS_VLLM_BASE_URL=http://host.docker.internal:8001/v1

# Baked into the frontend image at build time. Browser calls nginx, which
# routes /api/ingest to the ingest container and every other /api path to api.
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=8080
